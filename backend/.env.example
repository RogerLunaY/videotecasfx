# =====================================================
# Configuración de la Aplicación
# Sistema de Biblioteca Digital de Videos Educativos
# U.E. San Francisco Xavier
# =====================================================

# Entorno de la aplicación (development, production)
APP_ENV=development

# Modo debug (true, false)
APP_DEBUG=true

# URL base de la aplicación
APP_URL=http://localhost

# Zona horaria
APP_TIMEZONE=America/La_Paz

# =====================================================
# Configuración de Base de Datos
# =====================================================

# Host del servidor MySQL
DB_HOST=localhost

# Puerto del servidor MySQL
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=videoteca_sfx

# Usuario de la base de datos
DB_USER=root

# Contraseña de la base de datos
DB_PASS=

# =====================================================
# Configuración de JWT (JSON Web Tokens)
# =====================================================

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Cambiar en producción y mantener segura
JWT_SECRET=videoteca_sfx_secret_key_change_in_production_2024

# Algoritmo de encriptación (HS256, HS384, HS512)
JWT_ALGORITHM=HS256

# Emisor del token
JWT_ISSUER=videoteca_sfx_api

# Audiencia del token
JWT_AUDIENCE=videoteca_sfx_frontend

# Tiempo de vida del Access Token (segundos)
# 3600 = 1 hora
JWT_ACCESS_LIFETIME=3600

# Tiempo de vida del Refresh Token (segundos)
# 604800 = 7 días
JWT_REFRESH_LIFETIME=604800

# Margen de tiempo para validación (segundos)
JWT_LEEWAY=60

# =====================================================
# Configuración de CORS
# =====================================================

# Orígenes permitidos (separados por coma)
# Solo usado en producción (en desarrollo se permiten todos los localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================================================
# Configuración de Videos
# =====================================================

# Tamaño máximo de archivo en bytes
# 524288000 = 500 MB
VIDEO_MAX_SIZE=524288000

# =====================================================
# Configuración de Logging
# =====================================================

# Nivel de logging (debug, info, warning, error, critical)
LOG_LEVEL=info

# =====================================================
# NOTAS IMPORTANTES
# =====================================================
#
# 1. Copiar este archivo como .env en el directorio backend/
# 2. Modificar los valores según tu configuración local
# 3. NUNCA subir el archivo .env al repositorio
# 4. En producción, usar valores seguros y diferentes
# 5. La clave JWT_SECRET debe ser única y compleja en producción
#
